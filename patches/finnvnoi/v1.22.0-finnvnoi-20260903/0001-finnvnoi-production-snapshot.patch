+def _parse_bulk_usage_text_lines(text: str) -> list[str]:
+    keys: list[str] = []
+    for raw_line in text.splitlines():
+        line = raw_line.strip().strip(",")
+        if not line or line.startswith("#"):
+            continue
+        key = _coerce_bulk_usage_key(line)
+        if key:
+            keys.append(key)
+    return keys
