+        delta = choice.get("delta")
+        if not isinstance(delta, Mapping):
+            continue
+        for key in ("content", "refusal"):
+            value = delta.get(key)
+            if isinstance(value, str) and value.strip():
+                return True
+        tool_calls = delta.get("tool_calls")
+        if isinstance(tool_calls, list) and tool_calls:
